{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/cron/reports",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/reports",
      "schedule": "0 21 * * *"
    }
  ]
}
