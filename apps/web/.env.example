# Publieke browserconfiguratie.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Alleen server-side voor de beveiligde admin-uitnodigingsroute. Nooit NEXT_PUBLIC_ maken.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Publieke URL van de aparte private Drive-gateway. Laat leeg totdat alle
# server-side Google OAuth-secrets op die Worker zijn ingesteld.
NEXT_PUBLIC_STORAGE_GATEWAY_URL=https://codeco-storage-gateway.YOUR_ACCOUNT.workers.dev
