# Public browser configuration. Add these to the matching Vercel Environment.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-side only for the secured administrator invitation route. Never make this NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Private Vercel Blob storage. Create a private Blob store in the Vercel
# project and connect it to the desired environments. Vercel supplies
# BLOB_STORE_ID and a rotating VERCEL_OIDC_TOKEN automatically in deployments.
# For local development, `vercel env pull` can provide the store credentials.
BLOB_STORE_ID=store_YOUR_STORE_ID
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_LOCAL_FALLBACK_TOKEN

# A second private Blob store used only for database backups. This must not be
# the primary upload store, otherwise a store-level incident destroys both.
BACKUP_BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_SEPARATE_BACKUP_STORE_TOKEN

# Server-only authentication for the daily Vercel Cron job. Generate at least
# 32 random bytes and configure it only in the Production environment.
CRON_SECRET=YOUR_RANDOM_SERVER_ONLY_CRON_SECRET

# Optional email fallback (disabled by default in the application). Resend can
# be configured later and is not required for the push workflow.
RESEND_API_KEY=re_YOUR_SERVER_ONLY_API_KEY
NOTIFICATION_FROM_EMAIL=CODECO Supervisie <meldingen@YOUR_VERIFIED_DOMAIN>

# Browser push. Generate one VAPID key pair, keep the private key server-only,
# and use a monitored contact address in VAPID_SUBJECT.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_SERVER_ONLY_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:beheer@YOUR_DOMAIN

# Canonical production URL used in push actions and optional email fallback.
NEXT_PUBLIC_SITE_URL=https://code-co-nv.vercel.app
