# Public browser configuration. Add these to the matching Vercel Environment.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-side only for the secured administrator invitation route. Never make this NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Public URL of the separate private Drive gateway. Keep empty until all
# server-side Google OAuth secrets have been configured on that Worker.
NEXT_PUBLIC_STORAGE_GATEWAY_URL=https://codeco-storage-gateway.YOUR_ACCOUNT.workers.dev
